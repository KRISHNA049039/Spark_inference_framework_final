# Files that run or are read inside Linux containers keep LF line endings on
# every checkout, including Windows (CRLF breaks bash scripts and env files).
*.sh          text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.env         text eol=lf
*.conf        text eol=lf
*.txt         text eol=lf
Dockerfile*   text eol=lf
dockerignore  text eol=lf

# Windows-only scripts keep CRLF
*.ps1         text eol=crlf

# Binary documents and images
*.docx binary
*.pdf  binary
*.png  binary
*.drawio text
