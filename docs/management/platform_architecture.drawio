<mxfile host="app.diagrams.net" agent="build_diagrams.py" version="24.0.0" type="device"><diagram id="page0" name="1. Platform architecture: multilingual NER on a Spark cluste"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mgmt_platform_architecture_title" value="&lt;b&gt;1. Platform architecture: multilingual NER on a Spark cluster&lt;/b&gt;&lt;br&gt;Spark sends file names, not documents; each worker loads the models once and runs the whole pipeline" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1340" height="50" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_mn" value="&lt;b&gt;Master node&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="360" height="330" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_drv" value="&lt;b&gt;Driver (submit_pipeline_job.py)&lt;/b&gt;&lt;br&gt;lists the documents, splits them&lt;br&gt;into partitions, collects the results" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="320" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_sm" value="&lt;b&gt;Spark master :7077&lt;/b&gt;&lt;br&gt;assigns tasks to workers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="320" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_res" value="&lt;b&gt;Results (JSON per job)&lt;/b&gt;&lt;br&gt;language, translation, entities" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="320" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_wn" value="&lt;b&gt;Worker nodes (GPU), one or more&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="420" y="0" width="560" height="330" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_ex" value="&lt;b&gt;Spark executor: runs one task = a batch of file paths&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="520" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_p1" value="&lt;b&gt;1 Extract text&lt;/b&gt;&lt;br&gt;PDF, Office,&lt;br&gt;images (OCR)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="120" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_p2" value="&lt;b&gt;2 Detect&lt;/b&gt;&lt;br&gt;language" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="573" y="130" width="120" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_p3" value="&lt;b&gt;3 Translate&lt;/b&gt;&lt;br&gt;to English&lt;br&gt;(NLLB-200)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="706" y="130" width="120" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_p4" value="&lt;b&gt;4 Find&lt;/b&gt;&lt;br&gt;entities&lt;br&gt;(GLiNER)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="120" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_docs" value="&lt;b&gt;Input documents: same folder path on every node&lt;/b&gt;&lt;br&gt;200 languages; text, PDF, Word, Excel, PowerPoint, images" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="520" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_ms" value="&lt;b&gt;Model store (one setting)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1040" y="0" width="300" height="330" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_hdfs" value="&lt;b&gt;HDFS (production)&lt;/b&gt;&lt;br&gt;models kept once; each node&lt;br&gt;downloads and caches them" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1060" y="40" width="260" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_lfs" value="&lt;b&gt;Local folder (dev / air-gap)&lt;/b&gt;&lt;br&gt;E:\ner\models, read in place&lt;br&gt;no HDFS needed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_mdl" value="&lt;b&gt;GLiNER + NLLB-200 + backbone&lt;/b&gt;&lt;br&gt;~4.6 GB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="260" width="260" height="50" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_inf" value="&lt;b&gt;Runs on (each machine)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="370" width="1340" height="120" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_i1" value="&lt;b&gt;Windows 11 host&lt;/b&gt;&lt;br&gt;NVIDIA driver" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="240" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_i2" value="&lt;b&gt;WSL2 (Linux VM)&lt;/b&gt;&lt;br&gt;mirrored networking" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="240" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_i3" value="&lt;b&gt;Docker&lt;/b&gt;&lt;br&gt;Desktop (1 machine) or CE in Ubuntu (LAN)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="330" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_i4" value="&lt;b&gt;Images: multi-model-inference (Spark 3.5.1,&lt;/b&gt;&lt;br&gt;PyTorch 2.6, Java 17) + ner-translate-worker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="950" y="410" width="370" height="60" as="geometry"/></mxCell><mxCell id="mgmt_platform_architecture_e0" value="register job" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_drv" target="mgmt_platform_architecture_sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e1" value="launch tasks" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_sm" target="mgmt_platform_architecture_ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="378" y="190"/><mxPoint x="378" y="76"/></Array></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e2" value="file paths" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_drv" target="mgmt_platform_architecture_ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_p1" target="mgmt_platform_architecture_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_p2" target="mgmt_platform_architecture_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_p3" target="mgmt_platform_architecture_p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.115;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_ex" target="mgmt_platform_architecture_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e7" value="open files" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.115;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mgmt_platform_architecture_p1" target="mgmt_platform_architecture_docs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e8" value="load models" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_ex" target="mgmt_platform_architecture_hdfs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e9" value="or" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mgmt_platform_architecture_ex" target="mgmt_platform_architecture_lfs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e10" value="results" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_ex" target="mgmt_platform_architecture_res"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="402" y="94"/><mxPoint x="402" y="280"/></Array></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_i1" target="mgmt_platform_architecture_i2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_i2" target="mgmt_platform_architecture_i3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_platform_architecture_e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_platform_architecture_i3" target="mgmt_platform_architecture_i4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page1" name="2. Deployment options: where the cluster runs"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mgmt_deployment_options_title" value="&lt;b&gt;2. Deployment options: where the cluster runs&lt;/b&gt;&lt;br&gt;Same images and code in all three; only the start method and the model store change" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1320" height="50" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_ac" value="&lt;b&gt;A. One machine&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="420" height="400" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_a1" value="&lt;b&gt;Docker Desktop&lt;/b&gt;&lt;br&gt;one compose file&lt;br&gt;(docker-compose.airgap_sim.yml,&lt;br&gt;profile cluster)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="380" height="100" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_a2" value="&lt;b&gt;Models: local folder (dev.env)&lt;/b&gt;&lt;br&gt;Master + 1 worker on one PC" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="380" height="80" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_a3" value="&lt;b&gt;Use for: development, testing,&lt;/b&gt;&lt;br&gt;single air-gapped workstation&lt;br&gt;&lt;br&gt;Status: validated 27 and 30 Sep 2026" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="380" height="120" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_bc" value="&lt;b&gt;B. LAN cluster (Windows)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="450" y="0" width="420" height="400" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_b1" value="&lt;b&gt;Docker CE inside WSL2 Ubuntu&lt;/b&gt;&lt;br&gt;host networking,&lt;br&gt;one container per machine" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="470" y="40" width="380" height="100" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_b2" value="&lt;b&gt;Models: same folder on every node&lt;/b&gt;&lt;br&gt;or HDFS&lt;br&gt;Master PC + worker PCs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="380" height="80" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_b3" value="&lt;b&gt;Use for: multi-machine lab tests&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fragile: WSL idle shutdowns,&lt;br&gt;firewall resets after restarts&lt;br&gt;Status: validated 21 and 25 Sep 2026" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="470" y="260" width="380" height="120" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_cc" value="&lt;b&gt;C. Production (recommended)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="900" y="0" width="420" height="400" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_c1" value="&lt;b&gt;Linux servers or Kubernetes&lt;/b&gt;&lt;br&gt;native host networking,&lt;br&gt;no WSL layer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="380" height="100" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_c2" value="&lt;b&gt;Models: HDFS (download once,&lt;/b&gt;&lt;br&gt;cache per node)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="380" height="80" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_c3" value="&lt;b&gt;Use for: production and&lt;/b&gt;&lt;br&gt;large air-gapped deployments&lt;br&gt;&lt;br&gt;Status: design ready,&lt;br&gt;not yet built" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="380" height="120" as="geometry"/></mxCell><mxCell id="mgmt_deployment_options_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mgmt_deployment_options_a1" target="mgmt_deployment_options_a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mgmt_deployment_options_e1" value="" style="