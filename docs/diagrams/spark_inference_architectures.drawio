ell id="mode_rdd_lane0" value="&lt;b&gt;Driver (Python)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_rdd_lane1" value="&lt;b&gt;Driver JVM&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="112" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_rdd_lane2" value="&lt;b&gt;Executor JVM (on a worker)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="224" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_rdd_lane3" value="&lt;b&gt;Python worker process&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="336" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_rdd_lane4" value="&lt;b&gt;Device (CPU cores / GPU)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="448" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_rdd_gen" value="&lt;b&gt;1. Generate numpy data&lt;/b&gt;&lt;br&gt;signals (N,128) / images (N,3,224,224)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="12" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_split" value="&lt;b&gt;2. Split into P partition dicts&lt;/b&gt;&lt;br&gt;{model: array slice} x P" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="240" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_ser" value="&lt;b&gt;3. torch.save(state_dict) x models&lt;/b&gt;&lt;br&gt;sc.broadcast(bytes)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_agg" value="&lt;b&gt;9. Aggregate counts&lt;/b&gt;&lt;br&gt;throughput = samples / wall" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_par" value="&lt;b&gt;sc.parallelize(P)&lt;/b&gt;&lt;br&gt;pickled to temp file,&lt;br&gt;JVM reads -&amp;gt; ParallelCollectionRDD" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="240" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_job" value="&lt;b&gt;Job 0 -&amp;gt; Stage 0 (P tasks)&lt;/b&gt;&lt;br&gt;DAGScheduler; TaskScheduler fills&lt;br&gt;free slots (locality PROCESS_LOCAL)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_col" value="&lt;b&gt;collect(): result bytes from&lt;/b&gt;&lt;br&gt;every task (~2 KB each)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_tdes" value="&lt;b&gt;Task: deserialize closure&lt;/b&gt;&lt;br&gt;+ fetch broadcast pieces&lt;br&gt;(TorrentBroadcast, 4 MB blocks)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_prun" value="&lt;b&gt;PythonRunner&lt;/b&gt;&lt;br&gt;streams partition bytes to&lt;br&gt;the Python worker socket" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="696" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_tres" value="&lt;b&gt;Task result -&amp;gt; driver&lt;/b&gt;&lt;br&gt;(DirectTaskResult)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_load" value="&lt;b&gt;process_partition(): build 10 (or 1)&lt;/b&gt;&lt;br&gt;models, load_state_dict, .to(device)&lt;br&gt;= once per TASK / partition" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#c0392b;fontSize=11;fontColor=#7a1a12;" vertex="1" parent="1"><mxGeometry x="696" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_loop" value="&lt;b&gt;for model, for batch of B:&lt;/b&gt;&lt;br&gt;torch.from_numpy -&amp;gt; .to(device)&lt;br&gt;-&amp;gt; model(x) (output discarded)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="924" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_yld" value="&lt;b&gt;yield {partition, host, device,&lt;/b&gt;&lt;br&gt;load s, infer s, counts}" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_h2d" value="&lt;b&gt;cpu_only: oneDNN / MKL&lt;/b&gt;&lt;br&gt;AVX2 / AVX-512 kernels" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="696" y="474" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_krn" value="&lt;b&gt;gpu: H2D copy (pageable,&lt;/b&gt;&lt;br&gt;PCIe) + cuDNN/cuBLAS kernels" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="924" y="474" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_rdd_n1" value="&lt;b&gt;What the statistics show&lt;/b&gt;&lt;br&gt;&lt;br&gt;- 1 job, 1 stage, P tasks&lt;br&gt;- no shuffle&lt;br&gt;- model load repeats per task: P loads, even with python worker reuse (the function body re-runs for every partition)&lt;br&gt;- rdd_gpu on a mixed cluster: tasks that land on the CPU worker silently run on CPU (fallback)&lt;br&gt;- JVM CPU time ~ 0: the work is in Python / GPU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1430" y="26" width="260" height="300" as="geometry"/></mxCell><mxCell id="mode_rdd_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryD