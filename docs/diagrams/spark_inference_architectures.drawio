parent="1" source="ner_lifecycle_p5" target="ner_lifecycle_p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_lifecycle_e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_lifecycle_p7" target="ner_lifecycle_d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_lifecycle_e14" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_lifecycle_p6" target="ner_lifecycle_p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page24" name="25. NER on Spark - every data movement path"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1490" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ner_data_paths_title" value="&lt;b&gt;25. NER on Spark - every data movement path&lt;/b&gt;&lt;br&gt;(n) = path number in the text. Service mode: the kitchen reads the documents; cluster mode: the Python worker does (the primed paths)" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1410" height="50" as="geometry"/></mxCell><mxCell id="ner_data_paths_st" value="&lt;b&gt;Storage (outside Spark)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="720" as="geometry"/></mxCell><mxCell id="ner_data_paths_data" value="&lt;b&gt;Shared data volume&lt;/b&gt;&lt;br&gt;/app/data/ner_samples/*&lt;br&gt;host folder here; NFS on a real cluster&lt;br&gt;same absolute path on every node" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="260" height="100" as="geometry"/></mxCell><mxCell id="ner_data_paths_hdfs" value="&lt;b&gt;HDFS /models/weights&lt;/b&gt;&lt;br&gt;gliner-multi 2.3 GB&lt;br&gt;nllb-200-distilled-600M 2.5 GB&lt;br&gt;hf_cache 4 MB&lt;br&gt;namenode :9870 / datanode :9864" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="ner_data_paths_res" value="&lt;b&gt;Results volume&lt;/b&gt;&lt;br&gt;/app/results/&lt;br&gt;ner_translate_&amp;lt;ts&amp;gt;.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="260" height="80" as="geometry"/></mxCell><mxCell id="ner_data_paths_mn" value="&lt;b&gt;Master node (the driver runs here)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="340" y="0" width="330" height="720" as="geometry"/></mxCell><mxCell id="ner_data_paths_cli" value="&lt;b&gt;Driver Python&lt;/b&gt;&lt;br&gt;python submit_pipeline_job.py&lt;br&gt;-&amp;gt; text_pipeline_engine" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="290" height="70" as="geometry"/></mxCell><mxCell id="ner_data_paths_djvm" value="&lt;b&gt;Driver JVM (SparkSubmit via Py4J)&lt;/b&gt;&lt;br&gt;SparkContext, DAGScheduler,&lt;br&gt;TaskScheduler, BlockManager,&lt;br&gt;event log writer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="360" y="170" width="290" height="110" as="geometry"/></mxCell><mxCell id="ner_data_paths_sm" value="&lt;b&gt;Spark Master :7077&lt;/b&gt;&lt;br&gt;workers, cores, executors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="290" height="60" as="geometry"/></mxCell><mxCell id="ner_data_paths_nt" value="What travels through Spark: file names&lt;br&gt;(~40-70 bytes each), the pickled&lt;br&gt;closure, broadcast settings and the&lt;br&gt;result dicts. Document bytes never do." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="360" y="590" width="290" height="110" as="geometry"/></mxCell><mxCell id="ner_data_paths_wn" value="&lt;b&gt;Worker node&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="710" y="0" width="330" height="720" as="geometry"/></mxCell><mxCell id="ner_data_paths_wd" value="&lt;b&gt;Worker daemon&lt;/b&gt;&lt;br&gt;-c 4 -m 2g (service) / 6g (cluster)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="730" y="40" width="290" height="55" as="geometry"/></mxCell><mxCell id="ner_data_paths_exe" value="&lt;b&gt;Executor JVM&lt;/b&gt;&lt;br&gt;CoarseGrainedExecutorBackend&lt;br&gt;4 cores / spark.task.cpus 2 = 2 slots&lt;br&gt;TaskRunner threads" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="290" height="110" as="geometry"/></mxCell><mxCell id="ner_data_paths_pyw" value="&lt;b&gt;Python worker (one per running task)&lt;/b&gt;&lt;br&gt;forked by pyspark.daemon&lt;br&gt;runs process_partition()&lt;br&gt;cluster mode: reads the documents (8&amp;#x27;)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="730" y="320" width="290" height="100" as="geometry"/></mxCell><mxCell id="ner_data_paths_wc" value="&lt;b&gt;/model_cache&lt;/b&gt;&lt;br&gt;(cluster mode)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="730" y="470" width="135" height="60" as="geometry"/></mxCell><mxCell id="ner_data_paths_wg" value="&lt;b&gt;GPU&lt;/b&gt;&lt;br&gt;(cluster mode)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="885" y="470" width="135" height="60" as="geometry"/></mxCell><mxCell id="ner_data_paths_kn" value="&lt;b&gt;Model server node (service mode)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1080" y="0" width="330" height="720" as="geometry"/></mxCell><mxCell id="ner_data_paths_k" value="&lt;b&gt;Kitchen: uvicorn + FastAPI&lt;/b&gt;&lt;br&gt;POST /predict (thread pool)&lt;br&gt;GLiNER + NLLB loaded once&lt;br&gt;at startup" style="rounded=1;a