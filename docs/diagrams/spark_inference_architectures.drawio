dd_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_tdes" target="mode_rdd_prun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_prun" target="mode_rdd_load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_load" target="mode_rdd_loop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_loop" target="mode_rdd_krn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_loop" target="mode_rdd_yld"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_yld" target="mode_rdd_tres"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_tres" target="mode_rdd_col"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_rdd_col" target="mode_rdd_agg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_rdd_e14" value="cpu_only" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mode_rdd_load" target="mode_rdd_h2d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="3. Mode: pandas UDF - the repo's predict_batch_udf (udf_cpu "><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="632" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mode_udf_title" value="&lt;b&gt;3. Mode: pandas UDF - the repo&amp;#x27;s predict_batch_udf (udf_cpu / udf_gpu)&lt;/b&gt;&lt;br&gt;inference/cluster_engine_udf.py + inference/predict_batch_udf.py: DataFrame of flat float arrays, Arrow to Python, predictions returned" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1690" height="50" as="geometry"/></mxCell><mxCell id="mode_udf_lane0" value="&lt;b&gt;Driver (Python)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_udf_lane1" value="&lt;b&gt;Driver JVM&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="112" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_udf_lane2" value="&lt;b&gt;Executor JVM (on a worker)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="224" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_udf_lane3" value="&lt;b&gt;Python worker process&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="336" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_udf_lane4" value="&lt;b&gt;Device (CPU cores / GPU)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="448" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_udf_gen" value="&lt;b&gt;1. Generate numpy data&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="12" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_rows" value="&lt;b&gt;2. Row(input=x.reshape(-1).tolist())&lt;/b&gt;&lt;br&gt;one Python float object per value&lt;br&gt;(150,528 per image)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#c0392b;fontSize=11;fontColor=#7a1a12;" vertex="1" parent="1"><mxGeometry x="240" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_cdf" value="&lt;b&gt;3. createDataFrame(rows, schema)&lt;/b&gt;&lt;br&gt;.repartition(P)&lt;br&gt;.select(udf(input)).collect()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_preds" value="&lt;b&gt;9. predictions list per sample&lt;/b&gt;&lt;br&gt;(real outputs, unlike RDD)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_s0" value="&lt;b&gt;Stage A: parallelize rows -&amp;gt;&lt;/b&gt;&lt;br&gt;Exchange RoundRobinPartitioning(P)&lt;br&gt;(shuffle WRITE)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_s1" value="&lt;b&gt;Stage B (P tasks): shuffle READ -&amp;gt;&lt;/b&gt;&lt;br&gt;ArrowEvalPython -&amp;gt; collect&lt;br&gt;(AQE may coalesce partitions)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="696" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_col" value="&lt;b&gt;collect(): predictions&lt;/b&gt;&lt;br&gt;(output rows) to driver" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_shw" value="&lt;b&gt;Shuffle files on local disk,&lt;/b&gt;&lt;br&gt;served by BlockManager to&lt;br&gt;reducers on any node" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_arr" value="&lt;b&gt;Rows -&amp;gt; Arrow record batches&lt;/b&gt;&lt;br&gt;(maxRecordsPerBatch 10,000)&lt;br&gt;streamed to Python" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="696" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_tres" value="&lt;b&gt;Arrow batches of results&lt;/b&gt;&lt;br&gt;back to the JVM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_load" value="&lt;b&gt;_predict(): model_class() +&lt;/b&gt;&lt;br&gt;load_state_dict + .to(device)&lt;br&gt;once per TASK" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#c0392b;fontSize=11;fontColor=#7a1a12;" vertex="1" parent="1"><mxGeometry x="696" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_loop" value="&lt;b&gt;per Arrow batch: np.stack -&amp;gt;&lt;/b&gt;&lt;br&gt;re-chunk to B -&amp;gt; model(x)&lt;br&gt;-&amp;gt; .tolist() per row" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="924" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_yld" value="&lt;b&gt;yield pd.Series(list of&lt;/b&gt;&lt;br&gt;float lists)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_krn" value="&lt;b&gt;H2D + kernels (GPU)&lt;/b&gt;&lt;br&gt;or oneDNN (CPU)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="924" y="474" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_udf_n1" value="&lt;b&gt;What the statistics show&lt;/b&gt;&lt;br&gt;&lt;br&gt;- 2 stages (+ a shuffle): extra write/read of every input byte&lt;br&gt;- driver builds Python lists: ingestion dominates for images&lt;br&gt;- model load once per task&lt;br&gt;- per-sample predictions are returned (bigger results)&lt;br&gt;- device resolved per task: gpu_only on the CPU worker runs on CPU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1430" y="26" width="260" height="300" as="geometry"/></mxCell><mxCell id="mode_udf_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_gen" target="mode_udf_rows"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_rows" target="mode_udf_cdf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_cdf" target="mode_udf_s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_s0" target="mode_udf_shw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_s0" target="mode_udf_s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_s1" target="mode_udf_arr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_arr" target="mode_udf_load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_load" target="mode_udf_loop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_loop" target="mode_udf_krn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_loop" target="mode_udf_yld"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_yld" target="mode_udf_tres"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_tres" target="mode_udf_col"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_udf_col" target="mode_udf_preds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_udf_e13" value="shuffle fetch&lt;br&gt;(local / remote)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mode_udf_shw" target="mode_udf_arr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="4. Mode: Spark's built-in pyspark.ml.functions.predict_batch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="632" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mode_native_pbu_title" value="&lt;b&gt;4. Mode: Spark&amp;#x27;s built-in pyspark.ml.functions.predict_batch_udf (native_pbu_cpu / _gpu)&lt;/b&gt;&lt;br&gt;Same DataFrame + Arrow path as the pandas UDF; the model is cached per Python worker process and batched for you" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1690" height="50" as="geometry"/></mxCell><mxCell id="mode_native_pbu_lane0" value="&lt;b&gt;Driver (Python)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_native_pbu_lane1" value="&lt;b&gt;Driver JVM&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="112" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_native_pbu_lane2" value="&lt;b&gt;Executor JVM (on a worker)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="224" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_native_pbu_lane3" value="&lt;b&gt;Python worker process&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="336" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_native_pbu_lane4" value="&lt;b&gt;Device (CPU cores / GPU)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="448" width="1400" height="104" as="geometry"/></mxCell><mxCell id="mode_native_pbu_gen" value="&lt;b&gt;1. Generate data + broadcast&lt;/b&gt;&lt;br&gt;state_dict bytes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="12" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_cdf" value="&lt;b&gt;2. Same input DataFrame&lt;/b&gt;&lt;br&gt;(flat arrays, repartition P)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="240" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_mk" value="&lt;b&gt;3. predict_batch_udf(make_predict_fn,&lt;/b&gt;&lt;br&gt;return_type, batch_size=B,&lt;br&gt;input_tensor_shapes=[shape])" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_preds" value="&lt;b&gt;predictions per sample&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="26" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_s0" value="&lt;b&gt;Stage A: shuffle write&lt;/b&gt;&lt;br&gt;(repartition)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="468" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_s1" value="&lt;b&gt;Stage B: shuffle read -&amp;gt;&lt;/b&gt;&lt;br&gt;ArrowEvalPython (P tasks)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="696" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_col" value="&lt;b&gt;collect()&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="138" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_arr" value="&lt;b&gt;Arrow batches -&amp;gt; Python&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="696" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_tres" value="&lt;b&gt;results -&amp;gt; driver&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="250" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_cache" value="&lt;b&gt;make_predict_fn() runs ONCE per&lt;/b&gt;&lt;br&gt;Python worker (cached by UDF id);&lt;br&gt;later tasks on the same worker reuse it" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="468" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_bat" value="&lt;b&gt;Spark concatenates rows into&lt;/b&gt;&lt;br&gt;numpy batches of exactly B,&lt;br&gt;reshaped to input_tensor_shapes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="696" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_pred" value="&lt;b&gt;predict(np) -&amp;gt; torch -&amp;gt;&lt;/b&gt;&lt;br&gt;model -&amp;gt; numpy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="924" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_yld" value="&lt;b&gt;outputs -&amp;gt; Arrow&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1152" y="362" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_krn" value="&lt;b&gt;H2D + kernels (GPU)&lt;/b&gt;&lt;br&gt;or oneDNN (CPU)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="924" y="474" width="210" height="70" as="geometry"/></mxCell><mxCell id="mode_native_pbu_n1" value="&lt;b&gt;Why it differs from the repo UDF&lt;/b&gt;&lt;br&gt;&lt;br&gt;- model loads = number of Python workers, not number of tasks (needs spark.python.worker.reuse=true, set by the platform)&lt;br&gt;- batching and reshaping are built in (no manual re-chunk)&lt;br&gt;- same shuffle + Arrow ingestion cost&lt;br&gt;- available since Spark 3.4 (image has 3.5.1)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1430" y="26" width="260" height="300" as="geometry"/></mxCell><mxCell id="mode_native_pbu_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_gen" target="mode_native_pbu_cdf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_cdf" target="mode_native_pbu_mk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_mk" target="mode_native_pbu_s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_s0" target="mode_native_pbu_s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_s1" target="mode_native_pbu_arr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_arr" target="mode_native_pbu_bat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_cache" target="mode_native_pbu_pred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_bat" target="mode_native_pbu_pred"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_pred" target="mode_native_pbu_krn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_pred" target="mode_native_pbu_yld"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_yld" target="mode_native_pbu_tres"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_tres" target="mode_native_pbu_col"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_native_pbu_e12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_native_pbu_col" target="mode_native_pbu_preds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="5. Where tasks land: plain scheduling vs Spark GPU-aware sch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mode_gpu_aware_title" value="&lt;b&gt;5. Where tasks land: plain scheduling vs Spark GPU-aware scheduling&lt;/b&gt;&lt;br&gt;rdd_gpu (left) vs rdd_gpu_aware (right) on the same heterogeneous cluster" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1280" height="50" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_p0" value="&lt;b&gt;Plain: device_mode=gpu_only, no resource request&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="620" height="470" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_m0" value="&lt;b&gt;Spark Master&lt;/b&gt;&lt;br&gt;matches executor requests&lt;br&gt;to worker resources" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_cw0" value="&lt;b&gt;CPU worker (4 cores)&lt;/b&gt;&lt;br&gt;resources: none" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="260" height="70" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_gw0" value="&lt;b&gt;GPU worker (4 cores)&lt;/b&gt;&lt;br&gt;resources: gpu [0]&lt;br&gt;(discovery script)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="260" height="70" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_ce0" value="&lt;b&gt;Executor: 2 slots&lt;/b&gt;&lt;br&gt;torch.cuda.is_available()=False&lt;br&gt;-&amp;gt; falls back to CPU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#c0392b;fontSize=12;fontColor=#7a1a12;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="260" height="80" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_ge0" value="&lt;b&gt;Executor: 2 slots&lt;/b&gt;&lt;br&gt;runs on cuda" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="260" height="80" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_r0" value="&lt;b&gt;Tasks split across both executors: &amp;#x27;gpu_only&amp;#x27; results mix CPU and GPU&lt;/b&gt;&lt;br&gt;timings; the slowest (CPU) tasks decide the stage time" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#c0392b;fontSize=12;fontColor=#7a1a12;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="580" height="60" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_p660" value="&lt;b&gt;GPU-aware: executor.resource.gpu.amount=1, task.resource.gpu.amount=0.5&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="0" width="620" height="470" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_m660" value="&lt;b&gt;Spark Master&lt;/b&gt;&lt;br&gt;matches executor requests&lt;br&gt;to worker resources" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_cw660" value="&lt;b&gt;CPU worker (4 cores)&lt;/b&gt;&lt;br&gt;resources: none" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="260" height="70" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_gw660" value="&lt;b&gt;GPU worker (4 cores)&lt;/b&gt;&lt;br&gt;resources: gpu [0]&lt;br&gt;(discovery script)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="260" height="70" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_ce660" value="&lt;b&gt;no executor granted&lt;/b&gt;&lt;br&gt;(cannot satisfy gpu=1)&lt;br&gt;-&amp;gt; idle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="680" y="280" width="260" height="80" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_ge660" value="&lt;b&gt;Executor: 2 slots,&lt;/b&gt;&lt;br&gt;each task gets 0.5 GPU&lt;br&gt;(spark.task.resource.gpu.amount)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=12;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="260" height="80" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_r660" value="&lt;b&gt;All P tasks run on the GPU executor -&amp;gt; every task really uses cuda;&lt;/b&gt;&lt;br&gt;throughput limited to the GPU node&amp;#x27;s slots" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=12;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="680" y="390" width="580" height="60" as="geometry"/></mxCell><mxCell id="mode_gpu_aware_e0" value="grant" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_m0" target="mode_gpu_aware_cw0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e1" value="grant" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_m0" target="mode_gpu_aware_gw0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_cw0" target="mode_gpu_aware_ce0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_gw0" target="mode_gpu_aware_ge0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e4" value="grant?" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_m660" target="mode_gpu_aware_cw660"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e5" value="grant" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_m660" target="mode_gpu_aware_gw660"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="mode_gpu_aware_cw660" target="mode_gpu_aware_ce660"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_gpu_aware_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_gpu_aware_gw660" target="mode_gpu_aware_ge660"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="6. Mode: predict_batch_udf -&gt; Triton (triton_pbu) - Spark as"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mode_triton_pbu_title" value="&lt;b&gt;6. Mode: predict_batch_udf -&amp;gt; Triton (triton_pbu) - Spark as a client of a GPU inference service&lt;/b&gt;&lt;br&gt;Executors on BOTH nodes do only I/O; every forward pass runs inside Triton on the T4, batched across tasks" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1420" height="50" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_cpu" value="&lt;b&gt;CPU node&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="470" height="500" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_gpun" value="&lt;b&gt;GPU node&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="520" y="0" width="900" height="500" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_drv" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;input DataFrame, collect()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="200" height="60" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_ce" value="&lt;b&gt;Executor (CPU worker) - 2 task slots, no model, no GPU&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="430" height="60" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_c1" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;make_predict_fn():&lt;br&gt;grpc InferenceServerClient&lt;br&gt;(once per worker)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="205" height="110" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_c2" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;predict(batch of B)&lt;br&gt;-&amp;gt; client.infer()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="245" y="250" width="205" height="110" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_ge" value="&lt;b&gt;Executor (GPU worker) - 2 task slots, also only clients&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="380" height="60" as="geometry"/></mxCell><mxCell id="mode_triton_pbu_g1" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;gRPC client" style="roun