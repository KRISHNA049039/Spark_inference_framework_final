<mxfile host="app.diagrams.net" agent="build_diagrams.py" version="24.0.0" type="device"><diagram id="page0" name="1. Current platform: Spark standalone cluster doing in-proce"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="690" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="current_cluster_title" value="&lt;b&gt;1. Current platform: Spark standalone cluster doing in-process inference&lt;/b&gt;&lt;br&gt;Measured topology: CPU node (master + driver + CPU worker) and GPU node (GPU worker + Triton), AWS us-east-1, one subnet" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1180" height="50" as="geometry"/></mxCell><mxCell id="current_cluster_cpu" value="&lt;b&gt;CPU node - m5.2xlarge (8 vCPU, 32 GB)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="560" height="610" as="geometry"/></mxCell><mxCell id="current_cluster_gpun" value="&lt;b&gt;GPU node - g4dn.xlarge (4 vCPU, 16 GB, Tesla T4)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="620" y="0" width="560" height="610" as="geometry"/></mxCell><mxCell id="current_cluster_drv" value="&lt;b&gt;Driver (Python)&lt;/b&gt;&lt;br&gt;spark_modes_stats.py / submit_job.py&lt;br&gt;builds data, broadcasts weights" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="250" height="64" as="geometry"/></mxCell><mxCell id="current_cluster_djvm" value="&lt;b&gt;Driver JVM (SparkContext)&lt;/b&gt;&lt;br&gt;DAGScheduler -&amp;gt; stages&lt;br&gt;TaskScheduler -&amp;gt; task slots&lt;br&gt;BlockManager: broadcast pieces" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="250" height="90" as="geometry"/></mxCell><mxCell id="current_cluster_mst" value="&lt;b&gt;Spark Master :7077&lt;/b&gt;&lt;br&gt;registers workers, grants&lt;br&gt;executors to applications" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="240" height="64" as="geometry"/></mxCell><mxCell id="current_cluster_cw" value="&lt;b&gt;CPU Worker daemon&lt;/b&gt;&lt;br&gt;-c 4 -m 12g" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="240" height="50" as="geometry"/></mxCell><mxCell id="current_cluster_ce" value="&lt;b&gt;Executor JVM (CPU)&lt;/b&gt;&lt;br&gt;4 cores / spark.task.cpus=2&lt;br&gt;= 2 task slots" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="240" height="70" as="geometry"/></mxCell><mxCell id="current_cluster_cp1" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;forked by&lt;br&gt;pyspark.daemon&lt;br&gt;models on CPU&lt;br&gt;(oneDNN AVX-512)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="115" height="110" as="geometry"/></mxCell><mxCell id="current_cluster_cp2" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;2nd task slot&lt;br&gt;(same, reused&lt;br&gt;across tasks)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="425" y="360" width="115" height="110" as="geometry"/></mxCell><mxCell id="current_cluster_res" value="&lt;b&gt;Results&lt;/b&gt;&lt;br&gt;counts (RDD) or predictions&lt;br&gt;(UDF) -&amp;gt; collect() to driver" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="200" height="70" as="geometry"/></mxCell><mxCell id="current_cluster_ev" value="&lt;b&gt;Event log + REST :4040&lt;/b&gt;&lt;br&gt;per job / stage / task metrics" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="200" height="60" as="geometry"/></mxCell><mxCell id="current_cluster_gw" value="&lt;b&gt;GPU Worker daemon&lt;/b&gt;&lt;br&gt;-c 4 -m 12g&lt;br&gt;resource gpu:[0] (discovery script)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="240" height="60" as="geometry"/></mxCell><mxCell id="current_cluster_ge" value="&lt;b&gt;Executor JVM (GPU)&lt;/b&gt;&lt;br&gt;2 task slots&lt;br&gt;(GPU-aware: 0.5 GPU per task)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="240" width="240" height="70" as="geometry"/></mxCell><mxCell id="current_cluster_gp1" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;models on cuda&lt;br&gt;cudaMemcpy +&lt;br&gt;kernels" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="360" width="115" height="110" as="geometry"/></mxCell><mxCell id="current_cluster_gp2" value="&lt;b&gt;Python worker&lt;/b&gt;&lt;br&gt;2nd slot&lt;br&gt;shares the GPU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="785" y="360" width="115" height="110" as="geometry"/></mxCell><mxCell id="current_cluster_t4" value="&lt;b&gt;NVIDIA T4 (sm_75)&lt;/b&gt;&lt;br&gt;40 SMs, 2,560 FP32 lanes,&lt;br&gt;320 Tensor Cores, 16 GB GDDR6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="510" width="240" height="80" as="geometry"/></mxCell><mxCell id="current_cluster_trt" value="&lt;b&gt;Triton Inference Server&lt;/b&gt;&lt;br&gt;:8000 HTTP  :8001 gRPC&lt;br&gt;:8002 Prometheus metrics&lt;br&gt;dynamic batcher, 2 instances&lt;br&gt;per model on the T4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="930" y="240" width="230" height="110" as="geometry"/></mxCell><mxCell id="current_cluster_repo" value="&lt;b&gt;Model repository&lt;/b&gt;&lt;br&gt;resnet18/1/model.pt (TorchScript)&lt;br&gt;ew_classifier/1/model.pt" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="930" y="400" width="230" height="60" as="geometry"/></mxCell><mxCell id="current_cluster_e0" value="Py4J (TCP)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="current_cluster_drv" target="current_cluster_djvm"><mxGeometry relative="1" as="geomet