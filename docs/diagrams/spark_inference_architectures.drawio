ht="40" as="geometry"/></mxCell><mxCell id="ner_lifecycle_d0" value="images: spark-lean,&lt;br&gt;ner-translate-server,&lt;br&gt;ner-translate-worker,&lt;br&gt;apache/hadoop; weights&lt;br&gt;from Hugging Face" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_lifecycle_p1" value="&lt;b&gt;1 Transfer&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="240" y="0" width="200" height="40" as="geometry"/></mxCell><mxCell id="ner_lifecycle_d1" value="docker save tars +&lt;br&gt;weights + code bundle&lt;br&gt;-&amp;gt; media / diode -&amp;gt;&lt;br&gt;docker load; checksums" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_lifecycle_p2" value="&lt;b&gt;2 Store models&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="200" height="40" as="geometry"/></mxCell><mxCell id="ner_lifecycle_d2" value="hdfs dfs -put gliner-multi,&lt;br&gt;nllb-600M, hf_cache&lt;br&gt;-&amp;gt; /models/weights&lt;br&gt;(or copy to master FS)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_lifecycle_p3" value="&lt;b&gt;3 Start services&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="720" y="0" width="200" height="40" as="geometry"/></mxCell><mxCell id="ner_lifecycle_d3" value="HDFS; kitchen: fetch&lt;br&gt;models -&amp;gt; cache -&amp;gt; GPU;&lt;br&gt;Spark master + workers&lt;br&gt;register" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_lifecycle_p4" value="&lt;b&gt;4 Submit&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="200" height="40" as="geometry"/></mxCell><mxCell id="ner_lifecycle_d4" value="submit_pipeline_job:&lt;br&gt;manifest, files, master,&lt;br&gt;execution mode -&amp;gt;&lt;br&gt;SparkSession" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_lifecycle_p5" value="&lt;b&gt;5 Execute&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="240" y="240" width="200" height="40" as="geometry"/></mxCell><mxCell id="ner_lifecycle_d5" value="P tasks on worker slots;&lt;br&gt;service: POST /predict&lt;br&gt;cluster: load() + run()&lt;br&gt;in the executor" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="240" y="300" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_lifecycle_p6" value="&lt;b&gt;6 Collect&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=12;fontColor=#14501e;" vertex=