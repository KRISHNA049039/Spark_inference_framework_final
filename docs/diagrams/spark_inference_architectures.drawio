try x="1203" y="50" width="178" height="130" as="geometry"/></mxCell><mxCell id="ner_tensor_path_ne" value="&lt;b&gt;5 NLLB-200 600M (fp32)&lt;/b&gt;&lt;br&gt;encoder once per batch, then the decoder&lt;br&gt;runs one step per output token (KV cache)&lt;br&gt;until EOS / 400 tokens" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="610" y="340" width="330" height="110" as="geometry"/></mxCell><mxCell id="ner_tensor_path_ge" value="&lt;b&gt;8 GLiNER (fp16)&lt;/b&gt;&lt;br&gt;mDeBERTa-v3 encoder over words + labels&lt;br&gt;span representations x label embeddings&lt;br&gt;-&amp;gt; sigmoid scores per (span, label)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="380" height="110" as="geometry"/></mxCell><mxCell id="ner_tensor_path_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_tensor_path_f" target="ner_tensor_path_x"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_tensor_path_x" target="ner_tensor_path_p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_tensor_path_p" target="ner_tensor_path_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_tensor_path_d" target="ner_tensor_path_gt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e4" value="English / well-supported:&lt;br&gt;no translation" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ner_tensor_path_p" target="ner_tensor_path_gt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="501" y="32"/><mxPoint x="1104" y="32"/></Array></mxGeometry></mxCell><mxCell id="ner_tensor_path_e5" value="H2D ids" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_tensor_path_t" target="ner_tensor_path_ne"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e6" value="D2H ids" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ner_tensor_path_ne" target="ner_tensor_path_d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e7" value="H2D ids + masks" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_tensor_path_gt" target="ner_tensor_path_ge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_tensor_path_e8" value="D2H spans + scores" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ner_tensor_path_ge" target="ner_tensor_path_o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page27" name="28. Docker images - what is built from what"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="docker_image_tree_title" value="&lt;b&gt;28. Docker images - what is built from what&lt;/b&gt;&lt;br&gt;Three Dockerfiles, four images; arrows = FROM / build target. Sizes as listed by docker images on the laptop" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1400" height="50" as="geometry"/></mxCell><mxCell id="docker_image_tree_ubu" value="&lt;b&gt;ubuntu:22.04&lt;/b&gt;&lt;br&gt;(pulled)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="docker_image_tree_base" value="&lt;b&gt;stage spark-base  (deploy/Dockerfile)&lt;/b&gt;&lt;br&gt;Python 3.11, Java 17, Spark 3.5.1&lt;br&gt;no torch, no CUDA" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="280" y="25" width="300" height="90" as="geometry"/></mxCell><mxCell id="docker_image_tree_final" value="&lt;b&gt;multi-model-inference:latest&lt;/b&gt;&lt;br&gt;--target final (default)  27.7 GB&lt;br&gt;torch 2.6 cu126 + requirements.txt,&lt;br&gt;platform code, torchvision weights" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="0" width="330" height="115" as="geometry"/></mxCell><mxCell id="docker_image_tree_lean" value="&lt;b&gt;spark-lean:latest&lt;/b&gt;&lt;br&gt;--target lean  2.2 GB&lt;br&gt;pyspark + requests + platform code&lt;br&gt;no torch: talks to a model server" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="165" width="330" height="95" as="geometry"/></mxCell><mxCell id="docker_image_tree_worker" value="&lt;b&gt;ner-translate-worker:latest&lt;/b&gt;&lt;br&gt;deploy/Dockerfile.ner_translate  28.1 GB&lt;br&gt;FROM multi-model-inference + tesseract&lt;br&gt;/poppler (.deb bundle) + NER wheelhouse" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1070" y="0" width="330" height="115" as="geometry"/></mxCell><mxCell id="docker_image_tree_py" value="&lt;b&gt;python:3.11-slim-bookworm&lt;/b&gt;&lt;br&gt;(pulled)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="335" width="220" height="60" as="geometry"/></mxCell><mxCell id="docker_image_tree_server" value="&lt;b&gt;ner-translate-server:latest&lt;/b&gt;&lt;br&gt;deploy/Dockerfile.ner_translate_server  9.3 GB&lt;br&gt;tesseract + torch cu126 + NER wheelhouse,&lt;br&gt;no Spark / Java; code + weights mounted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="330" height="115" as="geometry"/></mxCell><mxCell id="docker_image_tree_inputs" value="&lt;b&gt;Offline build inputs&lt;/b&gt;&lt;br&gt;bind-mounted during the build, never an image layer:&lt;br&gt;wheels/ner_translate - pip wheelhouse&lt;br&gt;debs/ner_translate - apt .deb bundle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="330" height="110" as="geometry"/></mxCell><mxCell id="docker_image_tree_ext" value="&lt;b&gt;Pulled, not built&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="470" width="1400" height="100" as="geometry"/></mxCell><mxCell id="docker_image_tree_hadoop" value="&lt;b&gt;apache/hadoop:3.4.1  3.3 GB - HDFS namenode / datanode (air-gap simulation)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="505" width="420" height="50" as="geometry"/></mxCell><mxCell id="docker_image_tree_triton" value="&lt;b&gt;nvcr.io/nvidia/tritonserver:&amp;lt;tag&amp;gt; - Triton model server (AWS modes runs)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="470" y="505" width="440" height="50" as="geometry"/></mxCell><mxCell id="docker_image_tree_cuda" value="&lt;b&gt;nvidia/cuda:12.6.3-base - only for the nvidia-smi GPU check in setup scripts&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="940" y="505" width="440" height="50" as="geometry"/></mxCell><mxCell id="docker_image_tree_e0" value="FROM" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_image_tree_ubu" target="docker_image_tree_base"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_image_tree_e1" value="target final" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_image_tree_base" target="docker_image_tree_final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_image_tree_e2" value="target lean" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_image_tree_base" target="docker_image_tree_lean"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_image_tree_e3" value="FROM" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_image_tree_final" target="docker_image_tree_worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_image_tree_e4" value="FROM" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_image_tree_py" target="docker_image_tree_server"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="365"/><mxPoint x="440" y="367.5"/></Array></mxGeometry></mxCell><mxCell id="docker_image_tree_e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="docker_image_tree_inputs" target="docker_image_tree_worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_image_tree_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="docker_image_tree_inputs" target="docker_image_tree_server"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="367.5"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page28" name="29. Three ways the containers run a model - and which compos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="610" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="docker_architectures_title" value="&lt;b&gt;29. Three ways the containers run a model - and which compose files build each&lt;/b&gt;&lt;br&gt;[image] in brackets; host ports as published by the compose files" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1390" height="50" as="geometry"/></mxCell><mxCell id="docker_architectures_c0" value="&lt;b&gt;A. Shared cluster - models inside the executors&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="450" height="430" as="geometry"/></mxCell><mxCell id="docker_architectures_t0" value="&lt;b&gt;spark-master  [multi-model-inference]&lt;/b&gt;&lt;br&gt;master :7077, UI :8080, driver UI :4040&lt;br&gt;the driver runs here (docker exec)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="410" height="80" as="geometry"/></mxCell><mxCell id="docker_architectures_b0" value="&lt;b&gt;spark-gpu-worker / spark-cpu-worker&lt;/b&gt;&lt;br&gt;[multi-model-inference]&lt;br&gt;executors + Python workers load the&lt;br&gt;tensor models (GPU worker: on the GPU)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="410" height="95" as="geometry"/></mxCell><mxCell id="docker_architectures_n0" value="docker-compose.laptop.yml / .cluster.yml /&lt;br&gt;.cluster.linux.yml; docker run scripts:&lt;br&gt;start_cluster.ps1, setup_*.sh, AWS modes_node.sh&lt;br&gt;(+ Triton container for the Triton mode)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="410" height="100" as="geometry"/></mxCell><mxCell id="docker_architectures_c1" value="&lt;b&gt;B. Dedicated pipeline cluster (Option A)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="470" y="0" width="450" height="430" as="geometry"/></mxCell><mxCell id="docker_architectures_t1" value="&lt;b&gt;ner-translate-master  [ner-translate-worker]&lt;/b&gt;&lt;br&gt;host ports 7078 / 8081 / 4041&lt;br&gt;driver imports the pipeline" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="490" y="40" width="410" height="80" as="geometry"/></mxCell><mxCell id="docker_architectures_b1" value="&lt;b&gt;ner-translate-worker  [ner-translate-worker]&lt;/b&gt;&lt;br&gt;the executor&amp;#x27;s Python worker imports the&lt;br&gt;pipeline and loads GLiNER + NLLB itself" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="490" y="175" width="410" height="95" as="geometry"/></mxCell><mxCell id="docker_architectures_n1" value="docker-compose.ner_translate.yml&lt;br&gt;air-gap simulation, profile cluster&lt;br&gt;(sim-ner-cluster-master / -worker, 8084 / 4044)&lt;br&gt;when executors must own the models" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="310" width="410" height="100" as="geometry"/></mxCell><mxCell id="docker_architectures_c2" value="&lt;b&gt;C. Waiter / kitchen (Option B)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="940" y="0" width="450" height="430" as="geometry"/></mxCell><mxCell id="docker_architectures_t2" value="&lt;b&gt;ner-translate-master + ner-translate-worker&lt;/b&gt;&lt;br&gt;[spark-lean - no torch]&lt;br&gt;host ports 7080 / 8083 / 4043" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="410" height="80" as="geometry"/></mxCell><mxCell id="docker_architectures_b2" value="&lt;b&gt;ner-translate-server (kitchen)&lt;/b&gt;&lt;br&gt;[ner-translate-server]  FastAPI :8000 (host 8001)&lt;br&gt;GLiNER + NLLB loaded once on the GPU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="960" y="175" width="410" height="95" as="geometry"/></mxCell><mxCell id="docker_architectures_n2" value="docker-compose.ner_translate_server.yml&lt;br&gt;(start via setup_ner_translate_server.sh)&lt;br&gt;air-gap simulation, profile service (sim-*)&lt;br&gt;recommended for GPU pipelines" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="310" width="410" height="100" as="geometry"/></mxCell><mxCell id="docker_architectures_shared" value="&lt;b&gt;Shared by all of them: bind mounts ../data  ../models  ../results at the same path (/app/...) in every container - Spark sends file paths, each container opens the files itself.  Air-gap simulation adds HDFS (apache/hadoop) as the model store.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="470" width="1390" height="60" as="geometry"/></mxCell><mxCell id="docker_architectures_e0" value="tasks (RPC)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_architectures_t0" target="docker_architectures_b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_architectures_e1" value="tasks (RPC)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_architectures_t1" target="docker_architectures_b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="docker_architectures_e2" value="tasks -&amp;gt; worker -&amp;gt; HTTP POST /predict {paths}" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_architectures_t2" target="docker_architectures_b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page29" name="30. Which compose file or script to use"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="614" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="docker_decision_title" value="&lt;b&gt;30. Which compose file or script to use&lt;/b&gt;&lt;br&gt;Start from what you want to run; each leaf names the file and why" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1120" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_root" value="&lt;b&gt;What do you&lt;/b&gt;&lt;br&gt;want to run?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="250" width="190" height="70" as="geometry"/></mxCell><mxCell id="docker_decision_tm" value="&lt;b&gt;Tensor models&lt;/b&gt;&lt;br&gt;(10 built-ins, BYOM plugins)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="230" height="70" as="geometry"/></mxCell><mxCell id="docker_decision_ner" value="&lt;b&gt;NER pipeline&lt;/b&gt;&lt;br&gt;(documents -&amp;gt; entities)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="250" y="420" width="230" height="70" as="geometry"/></mxCell><mxCell id="docker_decision_lt0" value="one container, no cluster, code mounted&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.yml&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_lt1" value="Spark cluster on this laptop (1 GPU)&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.laptop.yml&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="62" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_lt2" value="several workers, Windows Docker Desktop&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.cluster.yml&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="124" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_lt3" value="one Linux host / EC2 (host network)&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.cluster.linux.yml&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="186" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_lt4" value="several machines: LAN lab / AWS&lt;br&gt;&lt;b&gt;-&amp;gt; start_cluster.ps1 / run_aws_*.ps1 (docker run)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="248" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_ln0" value="production shape: one model copy per GPU&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.ner_translate_server.yml&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_ln1" value="executors hold the models, no server&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.ner_translate.yml&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="422" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_ln2" value="models from HDFS / master FS + test suite&lt;br&gt;&lt;b&gt;-&amp;gt; docker-compose.airgap_sim.yml (profiles)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="560" y="484" width="560" height="50" as="geometry"/></mxCell><mxCell id="docker_decision_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_tm" target="docker_decision_lt0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="145"/><mxPoint x="520" y="25"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_tm" target="docker_decision_lt1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="145"/><mxPoint x="520" y="87"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_tm" target="docker_decision_lt2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="145"/><mxPoint x="520" y="149"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_tm" target="docker_decision_lt3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="145"/><mxPoint x="520" y="211"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_tm" target="docker_decision_lt4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="145"/><mxPoint x="520" y="273"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_ner" target="docker_decision_ln0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="455"/><mxPoint x="520" y="385"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_ner" target="docker_decision_ln1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="455"/><mxPoint x="520" y="447"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_ner" target="docker_decision_ln2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="455"/><mxPoint x="520" y="509"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_root" target="docker_decision_tm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="271"/><mxPoint x="220" y="145"/></Array></mxGeometry></mxCell><mxCell id="docker_decision_e9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docker_decision_root" target="docker_decision_ner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="299"/><mxPoint x="220" y="455"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page30" name="31. Who owns models and data - recommended air-gapped layout"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cluster_ownership_title" value="&lt;b&gt;31. Who owns models and data - recommended air-gapped layout (service mode)&lt;/b&gt;&lt;br&gt;Each box is a machine. The Spark master owns nothing: models live in the model store, documents in the shared folder" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1440" height="50" as="geometry"/></mxCell><mxCell id="cluster_ownership_st" value="&lt;b&gt;Storage node (10.0.0.5)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="330" height="470" as="geometry"/></mxCell><mxCell id="cluster_ownership_hdfs" value="&lt;b&gt;HDFS  (apache/hadoop)&lt;/b&gt;&lt;br&gt;namenode :8020 / WebHDFS :9870&lt;br&gt;datanode :9864 / :9866&lt;br&gt;/models/weights: gliner, nllb, hf_cache" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="290" height="110" as="geometry"/></mxCell><mxCell id="cluster_ownership_nfs" value="&lt;b&gt;Shared data folder (NFS export)&lt;/b&gt;&lt;br&gt;/srv/data  -&amp;gt;  mounted as /app/data&lt;br&gt;documents to process&lt;br&gt;(+ backend uploads)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="290" height="110" as="geometry"/></mxCell><mxCell id="cluster_ownership_nt1" value="OWNS: the model files and the&lt;br&gt;documents. Nothing else needs a copy&lt;br&gt;except the node caches." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="290" height="100" as="geometry"/></mxCell><mxCell id="cluster_ownership_mn" value="&lt;b&gt;Master node (10.0.0.10)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="380" y="0" width="330" height="470" as="geometry"/></mxCell><mxCell id="cluster_ownership_sm" value="&lt;b&gt;Spark master :7077  [spark-lean]&lt;/b&gt;&lt;br&gt;schedules only - owns nothing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="290" height="70" as="geometry"/></mxCell><mxCell id="cluster_ownership_drv" value="&lt;b&gt;Driver (submit_pipeline_job.py)&lt;/b&gt;&lt;br&gt;lists /app/data (needs the share)&lt;br&gt;writes results/ner_translate_&amp;lt;ts&amp;gt;.json" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="290" height="110" as="geometry"/></mxCell><mxCell id="cluster_ownership_res" value="&lt;b&gt;results/ (local or on the share)&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="290" height="60" as="geometry"/></mxCell><mxCell id="cluster_ownership_nt2" value="NEEDS: the data share (to list files).&lt;br&gt;No models." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="290" height="70" as="geometry"/></mxCell><mxCell id="cluster_ownership_gn" value="&lt;b&gt;GPU node (10.0.0.12)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="760" y="0" width="330" height="470" as="geometry"/></mxCell><mxCell id="cluster_ownership_kit" value="&lt;b&gt;Model server (kitchen)&lt;/b&gt;&lt;br&gt;[ner-translate-server]  :8000&lt;br&gt;opens the documents, runs OCR,&lt;br&gt;NLLB + GLiNER on the GPU" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="780" y="40" width="290" height="110" as="geometry"/></mxCell><mxCell id="cluster_ownership_kc" value="&lt;b&gt;/model_cache (local disk)&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="290" height="60" as="geometry"/></mxCell><mxCell id="cluster_ownership_nt3" value="NEEDS: the data share (same path),&lt;br&gt;WebHDFS access to the storage node&lt;br&gt;(first load), a GPU, &amp;gt;= 5 GB local disk.&lt;br&gt;OWNS: the only loaded copy of the&lt;br&gt;models." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="290" height="150" as="geometry"/></mxCell><mxCell id="cluster_ownership_wn" value="&lt;b&gt;Worker node(s) (10.0.0.11, ...)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1140" y="0" width="300" height="470" as="geometry"/></mxCell><mxCell id="cluster_ownership_wk" value="&lt;b&gt;Spark worker  [spark-lean]&lt;/b&gt;&lt;br&gt;executors send file NAMES to&lt;br&gt;the kitchen (HTTP)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1160" y="40" width="260" height="110" as="geometry"/></mxCell><mxCell id="cluster_ownership_nt4" value="NEEDS in service mode: nothing but&lt;br&gt;network - no data share, no models,&lt;br&gt;no GPU.&lt;br&gt;&lt;br&gt;In cluster mode it needs what the&lt;br&gt;GPU node needs: the data share,&lt;br&gt;WebHDFS access, a GPU, a local&lt;br&gt;model cache." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1160" y="200" width="260" height="250" as="geometry"/></mxCell><mxCell id="cluster_ownership_e0" value="WebHDFS, first load only" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cluster_ownership_hdfs" target="cluster_ownership_kc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="73"/><mxPoint x="345" y="-25"/><mxPoint x="740" y="-25"/><mxPoint x="740" y="230"/></Array></mxGeometry></mxCell><mxCell id="cluster_ownership_e1" value="load" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cluster_ownership_kc" target="cluster_ownership_kit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster_ownership_e2" value="NFS: list files" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cluster_ownership_nfs" target="cluster_ownership_drv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster_ownership_e3" value="NFS: read files" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="cluster_ownership_nfs" target="cluster_ownership_kit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="299"/><mxPoint x="345" y="370"/><mxPoint x="750" y="370"/><mxPoint x="750" y="128"/></Array></mxGeometry></mxCell><mxCell id="cluster_ownership_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cluster_ownership_drv" target="cluster_ownership_res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cluster_ownership_e5" value="tasks" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cluster_ownership_sm" target="cluster_o