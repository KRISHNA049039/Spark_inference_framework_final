Fill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="arch_recommended_as" target="arch_recommended_t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch_recommended_e12" value="read / write" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="arch_recommended_spk" target="arch_recommended_lake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="8. Alternative A: Triton sidecar on every GPU worker (co-loc"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="alt_sidecar_title" value="&lt;b&gt;8. Alternative A: Triton sidecar on every GPU worker (co-located)&lt;/b&gt;&lt;br&gt;Executors call Triton on localhost; no network hop for tensors, but GPU capacity is tied to Spark worker count" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1200" height="50" as="geometry"/></mxCell><mxCell id="alt_sidecar_n0" value="&lt;b&gt;GPU worker node 1&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="420" height="330" as="geometry"/></mxCell><mxCell id="alt_sidecar_e0" value="&lt;b&gt;Spark executor (Python workers, no model)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="380" height="60" as="geometry"/></mxCell><mxCell id="alt_sidecar_t0" value="&lt;b&gt;Triton (localhost :8001)&lt;/b&gt;&lt;br&gt;models resident, dynamic batching&lt;br&gt;across this node&amp;#x27;s tasks only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="380" height="80" as="geometry"/></mxCell><mxCell id="alt_sidecar_g0" value="&lt;b&gt;GPU&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="380" height="50" as="geometry"/></mxCell><mxCell id="alt_sidecar_n1" value="&lt;b&gt;GPU worker node 2&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="460" y="0" width="420" height="330" as="geometry"/></mxCell><mxCell id="alt_sidecar_e1" value="&lt;b&gt;Spark executor (Python workers, no model)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="380" height="60" as="geometry"/></mxCell><mxCell id="alt_sidecar_t1" value="&lt;b&gt;Triton (localhost :8001)&lt;/b&gt;&lt;br&gt;models resident, dynamic batching&lt;br&gt;across this node&amp;#x27;s tasks only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="380" height="80" as="geometry"/></mxCell><mxCell id="alt_sidecar_g1" value="&lt;b&gt;GPU&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="480" y="260" width="380" height="50" as="geometry"/></mxCell><mxCell id="alt_sidecar_drv" value="&lt;b&gt;Spark driver + master&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="alt_sidecar_pro" value="&lt;b&gt;+ lowest latency, no LB&lt;/b&gt;&lt;br&gt;+ Triton system shared memory&lt;br&gt;  avoids tensor copies&lt;br&gt;- batching only within a node&lt;br&gt;- GPUs idle when Spark is idle&lt;br&gt;- online traffic must also land&lt;br&gt;  on Spark nodes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="260" height="180" as="geometry"/></mxCell><mxCell id="alt_sidecar_e0" value="gRPC over loopback / shared memory" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_sidecar_e0" target="alt_sidecar_t0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_sidecar_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_sidecar_t0" target="alt_sidecar_g0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_sidecar_e2" value="gRPC over loopback / shared memory" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_sidecar_e1" target="alt_sidecar_t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_sidecar_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_sidecar_t1" target="alt_sidecar_g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_sidecar_e4" value="tasks" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_sidecar_drv" target="alt_sidecar_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="9. Alternative B: keep in-process inference, fix its overhea"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="alt_inprocess_title" value="&lt;b&gt;9. Alternative B: keep in-process inference, fix its overheads&lt;/b&gt;&lt;br&gt;No new service: GPU-aware scheduling + native predict_batch_udf caching + pinned memory + Arrow ingestion" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="1300" height="50" as="geometry"/></mxCell><mxCell id="alt_inprocess_drv" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;input as Parquet / Arrow&lt;br&gt;(no Python row lists)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="260" height="100" as="geometry"/></mxCell><mxCell id="alt_inprocess_sch" value="&lt;b&gt;Resource profiles (stage-level scheduling)&lt;/b&gt;&lt;br&gt;GPU stage: gpu.amount=1, task 0.25&lt;br&gt;CPU stage: pre/post-processing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="300" height="100" as="geometry"/></mxCell><mxCell id="alt_inprocess_ge" value="&lt;b&gt;GPU executors&lt;/b&gt;&lt;br&gt;native predict_batch_udf:&lt;br&gt;model cached per worker,&lt;br&gt;batch_size B, pinned memory,&lt;br&gt;CUDA streams / fp16" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="680" y="20" width="300" height="140" as="geometry"/></mxCell><mxCell id="alt_inprocess_ce" value="&lt;b&gt;CPU executors&lt;/b&gt;&lt;br&gt;ETL, feature prep, joins&lt;br&gt;(no models)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="680" y="190" width="300" height="90" as="geometry"/></mxCell><mxCell id="alt_inprocess_pro" value="&lt;b&gt;+ zero new infrastructure&lt;/b&gt;&lt;br&gt;+ data locality with Spark&lt;br&gt;+ works air-gapped today&lt;br&gt;- model memory per executor&lt;br&gt;- GPUs allocated per Spark app&lt;br&gt;  (idle between jobs)&lt;br&gt;- no online serving path&lt;br&gt;- one model version per job" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1040" y="20" width="260" height="260" as="geometry"/></mxCell><mxCell id="alt_inprocess_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_inprocess_drv" target="alt_inprocess_sch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_inprocess_e1" value="GPU stage" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_inprocess_sch" target="alt_inprocess_ge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_inprocess_e2" value="CPU stage" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_inprocess_sch" target="alt_inprocess_ce"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="235"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="10. Alternative C: Ray Data (batch) + Ray Serve (online)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="alt_ray_title" value="&lt;b&gt;10. Alternative C: Ray Data (batch) + Ray Serve (online)&lt;/b&gt;&lt;br&gt;Python-native actors hold models on GPUs; batch and online share one Ray cluster" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1320" height="50" as="geometry"/></mxCell><mxCell id="alt_ray_src" value="&lt;b&gt;Sources&lt;/b&gt;&lt;br&gt;Parquet / S3 / Kafka" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="220" height="80" as="geometry"/></mxCell><mxCell id="alt_ray_rc" value="&lt;b&gt;Ray cluster (head + CPU and GPU workers)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="260" y="0" width="760" height="330" as="geometry"/></mxCell><mxCell id="alt_ray_rd" value="&lt;b&gt;Ray Data pipeline&lt;/b&gt;&lt;br&gt;read -&amp;gt; map_batches(Preprocess, CPU)&lt;br&gt;-&amp;gt; map_batches(ModelActor, num_gpus=1,&lt;br&gt;concurrency=N) -&amp;gt; write" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="330" height="110" as="geometry"/></mxCell><mxCell id="alt_ray_act" value="&lt;b&gt;GPU actor pool&lt;/b&gt;&lt;br&gt;model loaded once per actor,&lt;br&gt;streaming execution, backpressure,&lt;br&gt;autoscaling actors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="660" y="40" width="340" height="110" as="geometry"/></mxCell><mxCell id="alt_ray_rs" value="&lt;b&gt;Ray Serve deployments&lt;/b&gt;&lt;br&gt;HTTP/gRPC ingress, @serve.batch,&lt;br&gt;model composition (pipelines)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="280" y="190" width="330" height="110" as="geometry"/></mxCell><mxCell id="alt_ray_gpu" value="&lt;b&gt;GPUs (fractional num_gpus&lt;/b&gt;&lt;br&gt;allows sharing)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="190" width="340" height="110" as="geometry"/></mxCell><mxCell id="alt_ray_pro" value="&lt;b&gt;+ one framework for batch + online&lt;/b&gt;&lt;br&gt;+ Python-native (fits torch code)&lt;br&gt;+ fine-grained GPU sharing&lt;br&gt;- replaces Spark for this workload&lt;br&gt;- new cluster to operate&lt;br&gt;- less mature than Triton for&lt;br&gt;  multi-framework serving" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1060" y="20" width="260" height="300" as="geometry"/></mxCell><mxCell id="alt_ray_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_ray_src" target="alt_ray_rd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_ray_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_ray_rd" target="alt_ray_act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_ray_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_ray_act" target="alt_ray_gpu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_ray_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_ray_rs" target="alt_ray_gpu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page10" name="11. Alternative D: Kubernetes - Spark on K8s + KServe with t"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="alt_k8s_title" value="&lt;b&gt;11. Alternative D: Kubernetes - Spark on K8s + KServe with the Triton runtime&lt;/b&gt;&lt;br&gt;Everything is a pod; GPU nodes are shared by scheduling, scaling is declarative" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1350" height="50" as="geometry"/></mxCell><mxCell id="alt_k8s_k" value="&lt;b&gt;Kubernetes cluster (EKS / on-prem), NVIDIA GPU operator&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1060" height="360" as="geometry"/></mxCell><mxCell id="alt_k8s_so" value="&lt;b&gt;Spark operator&lt;/b&gt;&lt;br&gt;SparkApplication CRD&lt;br&gt;driver + executor pods (CPU pool)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="300" height="90" as="geometry"/></mxCell><mxCell id="alt_k8s_ks" value="&lt;b&gt;KServe InferenceService&lt;/b&gt;&lt;br&gt;runtime: tritonserver&lt;br&gt;storageUri: s3://models/..." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="300" height="90" as="geometry"/></mxCell><mxCell id="alt_k8s_sc" value="&lt;b&gt;Autoscaling&lt;/b&gt;&lt;br&gt;Knative / HPA / KEDA on&lt;br&gt;concurrency or queue time" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="740" y="40" width="300" height="90" as="geometry"/></mxCell><mxCell id="alt_k8s_cpu" value="&lt;b&gt;CPU node pool (spot)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="300" height="70" as="geometry"/></mxCell><mxCell id="alt_k8s_gp" value="&lt;b&gt;GPU node pool&lt;/b&gt;&lt;br&gt;(time-slicing or MIG to share)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="300" height="70" as="geometry"/></mxCell><mxCell id="alt_k8s_ig" value="&lt;b&gt;Ingress / service mesh&lt;/b&gt;&lt;br&gt;(Istio / Envoy), mTLS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="300" height="70" as="geometry"/></mxCell><mxCell id="alt_k8s_pv" value="&lt;b&gt;Shared: model store (S3/MinIO), Prometheus + Grafana, image registry (air-gapped: Harbor)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1020" height="50" as="geometry"/></mxCell><mxCell id="alt_k8s_pro" value="&lt;b&gt;+ one scheduler for data + serving&lt;/b&gt;&lt;br&gt;+ scale-to-zero, canary /&lt;br&gt;  A-B model rollout built in&lt;br&gt;+ standard for platform teams&lt;br&gt;- biggest operational lift&lt;br&gt;- K8s + GPU operator expertise&lt;br&gt;- air-gapped K8s is work" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="0" width="250" height="360" as="geometry"/></mxCell><mxCell id="alt_k8s_e0" value="gRPC&lt;br&gt;(predict_batch_udf)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_k8s_so" target="alt_k8s_ks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_k8s_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_k8s_so" target="alt_k8s_cpu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_k8s_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_k8s_ks" target="alt_k8s_gp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_k8s_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_k8s_sc" target="alt_k8s_ks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_k8s_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_k8s_ig" target="alt_k8s_ks"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="211"/><mxPoint x="720" y="121"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page11" name="12. Alternative E: asynchronous, queue-driven inference"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="alt_queue_title" value="&lt;b&gt;12. Alternative E: asynchronous, queue-driven inference&lt;/b&gt;&lt;br&gt;Producers publish work; GPU consumers pull at their own pace; results land in a store" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-30" width="1200" height="50" as="geometry"/></mxCell><mxCell id="alt_queue_p1" value="&lt;b&gt;Sensors / apps&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="220" height="60" as="geometry"/></mxCell><mxCell id="alt_queue_p2" value="&lt;b&gt;Spark jobs (enqueue&lt;/b&gt;&lt;br&gt;partitions as messages)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="220" height="60" as="geometry"/></mxCell><mxCell id="alt_queue_k" value="&lt;b&gt;Kafka / SQS / Redis Streams&lt;/b&gt;&lt;br&gt;requests topic&lt;br&gt;(partitioned by model)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="260" height="100" as="geometry"/></mxCell><mxCell id="alt_queue_c" value="&lt;b&gt;Consumer group on GPU nodes&lt;/b&gt;&lt;br&gt;pull N messages -&amp;gt; one batch&lt;br&gt;-&amp;gt; Triton (localhost)&lt;br&gt;or in-process model&lt;br&gt;commit offsets after write" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="600" y="30" width="300" height="160" as="geometry"/></mxCell><mxCell id="alt_queue_r" value="&lt;b&gt;Results topic / Cassandra&lt;/b&gt;&lt;br&gt;(predictions + lineage)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="240" height="100" as="geometry"/></mxCell><mxCell id="alt_queue_pro" value="&lt;b&gt;+ absorbs bursts, natural backpressure, retries/DLQ, decouples producers from GPU capacity   - adds latency (seconds), ordering/idempotency to design, another system to run&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="0" y="230" width="1200" height="70" as="geometry"/></mxCell><mxCell id="alt_queue_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_queue_p1" target="alt_queue_k"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_queue_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_queue_p2" target="alt_queue_k"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_queue_e2" value="consume" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_queue_k" target="alt_queue_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alt_queue_e3" value="produce" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt_queue_c" target="alt_queue_r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page12" name="13. Recommended deployment on AWS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws_topology_title" value="&lt;b&gt;13. Recommended deployment on AWS&lt;/b&gt;&lt;br&gt;Private subnets, NLB/ALB in front of an Auto Scaling group of Triton GPU nodes; Spark (EMR or self-managed) as a client" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1320" height="50" as="geometry"/></mxCell><mxCell id="aws_topology_vpc" value="&lt;b&gt;VPC (2-3 AZs)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1320" height="520" as="geometry"/></mxCell><mxCell id="aws_topology_pub" value="&lt;b&gt;Public subnets&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="260" height="460" as="geometry"/></mxCell><mxCell id="aws_topology_alb" value="&lt;b&gt;ALB (HTTP/2, gRPC)&lt;/b&gt;&lt;br&gt;WAF, TLS termination" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="aws_topology_nat" value="&lt;b&gt;NAT GW / VPC endpoints&lt;/b&gt;&lt;br&gt;(S3, ECR, CloudWatch)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="220" height="60" as="geometry"/></mxCell><mxCell id="aws_topology_pa" value="&lt;b&gt;Private subnets - inference tier&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="310" y="40" width="520" height="460" as="geometry"/></mxCell><mxCell id="aws_topology_nlb" value="&lt;b&gt;Internal NLB / ALB target group (gRPC health: /v2/health/ready)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="480" height="60" as="geometry"/></mxCell><mxCell id="aws_topology_t0" value="&lt;b&gt;g4dn/g5 #1&lt;/b&gt;&lt;br&gt;Triton container&lt;br&gt;(ECS/EKS/ASG)&lt;br&gt;IMDSv2, SSM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="330" y="180" width="150" height="120" as="geometry"/></mxCell><mxCell id="aws_topology_t1" value="&lt;b&gt;g4dn/g5 #2&lt;/b&gt;&lt;br&gt;Triton container&lt;br&gt;(ECS/EKS/ASG)&lt;br&gt;IMDSv2, SSM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="490" y="180" width="150" height="120" as="geometry"/></mxCell><mxCell id="aws_topology_t2" value="&lt;b&gt;g4dn/g5 #3&lt;/b&gt;&lt;br&gt;Triton container&lt;br&gt;(ECS/EKS/ASG)&lt;br&gt;IMDSv2, SSM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="650" y="180" width="150" height="120" as="geometry"/></mxCell><mxCell id="aws_topology_asg" value="&lt;b&gt;Auto Scaling group: target tracking on Triton queue time (custom metric)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="480" height="60" as="geometry"/></mxCell><mxCell id="aws_topology_cw" value="&lt;b&gt;CloudWatch / Managed Prometheus + Grafana (metrics :8002, logs)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="480" height="60" as="geometry"/></mxCell><mxCell id="aws_topology_pb" value="&lt;b&gt;Private subnets - data tier&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="440" height="460" as="geometry"/></mxCell><mxCell id="aws_topology_emr" value="&lt;b&gt;EMR / Spark on EC2 (CPU, spot)&lt;/b&gt;&lt;br&gt;lean image: pyspark + tritonclient&lt;br&gt;predict_batch_udf -&amp;gt; internal NLB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="400" height="110" as="geometry"/></mxCell><mxCell id="aws_topology_s3" value="&lt;b&gt;S3 model repo&lt;/b&gt;&lt;br&gt;(versioned, KMS)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="190" height="90" as="geometry"/></mxCell><mxCell id="aws_topology_data" value="&lt;b&gt;S3 / Cassandra&lt;/b&gt;&lt;br&gt;inputs + outputs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1090" y="230" width="190" height="90" as="geometry"/></mxCell><mxCell id="aws_topology_ci" value="&lt;b&gt;CodePipeline / GitHub Actions&lt;/b&gt;&lt;br&gt;export -&amp;gt; perf_analyzer -&amp;gt; accuracy gate&lt;br&gt;-&amp;gt; publish model version -&amp;gt; rolling reload" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="400" height="110" as="geometry"/></mxCell><mxCell id="aws_topology_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aws_topology_alb" target="aws_topology_nlb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aws_topology_nlb" target="aws_topology_t0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aws_topology_nlb" target="aws_topology_t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aws_topology_nlb" target="aws_topology_t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e4" value="gRPC" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aws_topology_emr" target="aws_topology_nlb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e5" value="load" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="aws_topology_s3" target="aws_topology_t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aws_topology_ci" target="aws_topology_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws_topology_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="aws_topology_emr" target="aws_topology_data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page13" name="14. Air-gapped / on-prem variant (matches docs/AIRGAPPED_*)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="airgapped_topology_title" value="&lt;b&gt;14. Air-gapped / on-prem variant (matches docs/AIRGAPPED_*)&lt;/b&gt;&lt;br&gt;No internet: images, wheels and model versions arrive through a controlled transfer; everything else is identical" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1320" height="50" as="geometry"/></mxCell><mxCell id="airgapped_topology_in" value="&lt;b&gt;Connected build enclave&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="400" as="geometry"/></mxCell><mxCell id="airgapped_topology_b1" value="&lt;b&gt;Build images: tritonserver,&lt;/b&gt;&lt;br&gt;spark-lean + tritonclient" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="260" height="80" as="geometry"/></mxCell><mxCell id="airgapped_topology_b2" value="&lt;b&gt;Export + validate models&lt;/b&gt;&lt;br&gt;(perf_analyzer, accuracy)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=12;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="260" height="80" as="geometry"/></mxCell><mxCell i