" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_triton_pbu_q" target="mode_triton_pbu_i2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_triton_pbu_e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_triton_pbu_i1" target="mode_triton_pbu_t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mode_triton_pbu_e14" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mode_triton_pbu_i2" target="mode_triton_pbu_t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="7. Recommended: Triton in front of the cluster (online + bat"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch_recommended_title" value="&lt;b&gt;7. Recommended: Triton in front of the cluster (online + batch share one GPU inference tier)&lt;/b&gt;&lt;br&gt;Spark keeps what it is good at (partitioned data movement, joins, writes); GPUs live behind Triton with models resident and batching across callers" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1400" height="50" as="geometry"/></mxCell><mxCell id="arch_recommended_cons" value="&lt;b&gt;Consumers&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="250" height="520" as="geometry"/></mxCell><mxCell id="arch_recommended_apps" value="&lt;b&gt;Online apps / APIs&lt;/b&gt;&lt;br&gt;(interactive, p99 SLO)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="210" height="70" as="geometry"/></mxCell><mxCell id="arch_recommended_spk" value="&lt;b&gt;Spark batch cluster&lt;/b&gt;&lt;br&gt;(lean CPU image, no torch/CUDA)&lt;br&gt;input -&amp;gt; predict_batch_udf&lt;br&gt;(Triton gRPC client)&lt;br&gt;-&amp;gt; joins / writes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="210" height="150" as="geometry"/></mxCell><mxCell id="arch_recommended_pipe" value="&lt;b&gt;Pipelines&lt;/b&gt;&lt;br&gt;(ner_translate: OCR + NER + MT)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="210" height="70" as="geometry"/></mxCell><mxCell id="arch_recommended_lake" value="&lt;b&gt;Data: S3 / HDFS / Cassandra&lt;/b&gt;&lt;br&gt;(inputs &amp;amp; predictions)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="210" height="80" as="geometry"/></mxCell><mxCell id="arch_recommended_edge" value="&lt;b&gt;Access tier&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;alig