" parent="1" source="model_fetch_sequence_pa2" target="model_fetch_sequence_pb2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e3" value="3b no -&amp;gt; GETFILESTATUS / LISTSTATUS (walk the tree)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model_fetch_sequence_pa3" target="model_fetch_sequence_pb3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e4" value="4 per file: GET ?op=OPEN" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model_fetch_sequence_pa4" target="model_fetch_sequence_pb4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e5" value="5 HTTP 307 redirect to the datanode holding the blocks" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="model_fetch_sequence_pa5" target="model_fetch_sequence_pb5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e6" value="6 follow redirect, stream bytes (8 MB chunks)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model_fetch_sequence_pa6" target="model_fetch_sequence_pb6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e7" value="7 file bytes" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="model_fetch_sequence_pa7" target="model_fetch_sequence_pb7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e8" value="8 write into .partial-*/, check size == HDFS length" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model_fetch_sequence_pa8" target="model_fetch_sequence_pb8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e9" value="9 os.replace(.partial -&amp;gt; final) + write .complete (atomic publish)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="model_fetch_sequence_pa9" target="model_fetch_sequence_pb9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="model_fetch_sequence_e10" value="10 local path -&amp;gt; from_pretrained(local path)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="model_fetch_sequence_pa10" target="model_fetch_sequence_pb10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page22" name="23. What happens to every document (models/pipelines/ner_tra"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ner_document_pipeline_title" value="&lt;b&gt;23. What happens to every document (models/pipelines/ner_translate/mt_ner_all_formats.py)&lt;/b&gt;&lt;br&gt;process_paths_batched(): extract -&amp;gt; detect -&amp;gt; route -&amp;gt; translate (batched per language) -&amp;gt; NER (batched across documents) -&amp;gt; merge" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-20" width="1000" height="50" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_in" value="&lt;b&gt;Input file&lt;/b&gt;&lt;br&gt;txt md csv json html&lt;br&gt;pdf docx odt rtf epub&lt;br&gt;pptx xlsx xls ods&lt;br&gt;png jpg tif ..." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="170" height="90" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_ex" value="&lt;b&gt;1 extract_text()&lt;/b&gt;&lt;br&gt;by extension; PDF text&lt;br&gt;layer, else OCR 300 dpi&lt;br&gt;(tesseract, 11 Indic+EN&lt;br&gt;languages)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_pp" value="&lt;b&gt;2 preprocess()&lt;/b&gt;&lt;br&gt;NFC normalise,&lt;br&gt;strip BOM / nbsp,&lt;br&gt;collapse spaces" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="160" height="90" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_li" value="&lt;b&gt;3 detect_language()&lt;/b&gt;&lt;br&gt;py3langid on the&lt;br&gt;first 1,000 chars" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="610" y="40" width="170" height="90" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_ro" value="&lt;b&gt;4 route&lt;/b&gt;&lt;br&gt;en fr de es it pt -&amp;gt; direct&lt;br&gt;hi mr te ta kn bn gu pa ml&lt;br&gt;ur ar zh ja ko ru ... -&amp;gt; translate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_tr" value="&lt;b&gt;5 translate (NLLB-200)&lt;/b&gt;&lt;br&gt;one unit per sentence / line&lt;br&gt;(danda-aware), grouped by&lt;br&gt;source language, batch 8,&lt;br&gt;&amp;lt;=400 tokens -&amp;gt; English" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="810" y="180" width="190" height="110" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_ch" value="&lt;b&gt;6 chunk_text()&lt;/b&gt;&lt;br&gt;sentence split, &amp;lt;=1,500&lt;br&gt;chars, keep offsets;&lt;br&gt;chunks of ALL documents&lt;br&gt;pooled together" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_ne" value="&lt;b&gt;7 GLiNER NER (fp16)&lt;/b&gt;&lt;br&gt;zero-shot, 19 labels&lt;br&gt;(person, rank, unit,&lt;br&gt;weapon, location ...),&lt;br&gt;threshold 0.35, batch 16" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="350" y="180" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_ph" value="&lt;b&gt;8 regex phone numbers&lt;/b&gt;&lt;br&gt;on translated AND&lt;br&gt;original text (digits&lt;br&gt;survive translation)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="200" height="110" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_out" value="&lt;b&gt;9 per document: {path, language, translated, text_used, original_text, entities_all, entities_unique (deduped by text+type, best score)} - keyed by file name&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="0" y="330" width="1000" height="70" as="geometry"/></mxCell><mxCell id="ner_document_pipeline_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_in" target="ner_document_pipeline_ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_ex" target="ner_document_pipeline_pp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_pp" target="ner_document_pipeline_li"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_li" target="ner_document_pipeline_ro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e4" value="translate path" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_ro" target="ner_document_pipeline_tr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e5" value="direct path" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_ro" target="ner_document_pipeline_ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="829" y="150"/><mxPoint x="800" y="150"/><mxPoint x="800" y="202"/></Array></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e6" value="English text" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ner_document_pipeline_tr" target="ner_document_pipeline_ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ner_document_pipeline_e7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBac