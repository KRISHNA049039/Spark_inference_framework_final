</mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e5" value="4b mapPartitions (lean image, requests only)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_seq_pipeline_pa7" target="tdd_seq_pipeline_pb7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e6" value="5b POST /predict {paths, labels}" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_seq_pipeline_pa8" target="tdd_seq_pipeline_pb8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e7" value="6b pipeline.run(loaded once at startup)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_seq_pipeline_pa9" target="tdd_seq_pipeline_pb9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e8" value="7b results" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tdd_seq_pipeline_pa10" target="tdd_seq_pipeline_pb10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e9" value="8b JSON {file: result}" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tdd_seq_pipeline_pa11" target="tdd_seq_pipeline_pb11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e10" value="9 yield per-partition results" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tdd_seq_pipeline_pa12" target="tdd_seq_pipeline_pb12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_seq_pipeline_e11" value="10 merged results + partition details" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#57606a;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tdd_seq_pipeline_pa13" target="tdd_seq_pipeline_pb13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page18" name="19. Extension points: where new code plugs in"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1370" pageHeight="450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tdd_plugin_flow_title" value="&lt;b&gt;19. Extension points: where new code plugs in&lt;/b&gt;&lt;br&gt;Tensor models (BYOM plugins), file pipelines, engines, Triton models - each needs only the files listed" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1290" height="50" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_p1" value="&lt;b&gt;A. Tensor model plugin (BYOM)&lt;/b&gt;&lt;br&gt;1 models/plugins/my_model.py&lt;br&gt;   class MyModel(nn.Module), no-arg __init__&lt;br&gt;2 models/plugins/manifest.json entry&lt;br&gt;   module, class_name, input_shape, weights_path&lt;br&gt;3 python submit_job.py --model my_model" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="150" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_p2" value="&lt;b&gt;B. File pipeline&lt;/b&gt;&lt;br&gt;1 models/pipelines/&amp;lt;name&amp;gt;/pipeline.py&lt;br&gt;   load() -&amp;gt; state; run(state, paths) -&amp;gt; dict&lt;br&gt;2 models/pipelines/manifest.json&lt;br&gt;   module, service_url?, master_url?&lt;br&gt;3 requirements.txt + Dockerfile.&amp;lt;name&amp;gt;&lt;br&gt;4 optional serve.py (kitchen)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="330" y="0" width="300" height="150" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_p3" value="&lt;b&gt;C. Execution engine&lt;/b&gt;&lt;br&gt;1 inference/my_engine.py&lt;br&gt;   run_...(spark, data, models, P, B,&lt;br&gt;   device_mode) -&amp;gt; same keys as&lt;br&gt;   run_cluster_inference()&lt;br&gt;2 add to submit_job --engine" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="660" y="0" width="300" height="150" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_p4" value="&lt;b&gt;D. Triton-served model&lt;/b&gt;&lt;br&gt;1 add to EXPORT in&lt;br&gt;   benchmark/triton_export.py&lt;br&gt;2 export -&amp;gt; model repo&lt;br&gt;3 --verify vs eager&lt;br&gt;4 client via predict_batch_udf" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f5e1;strokeColor=#2e8b3d;fontSize=11;fontColor=#14501e;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="300" height="150" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_r" value="&lt;b&gt;ModelRegistry (models/__init__.py + plugin_loader.register_plugins)&lt;/b&gt;&lt;br&gt;name -&amp;gt; class, input_shape, category, est. memory" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="210" width="630" height="70" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_cm" value="&lt;b&gt;cluster_engine._get_class_map()&lt;/b&gt;&lt;br&gt;built-ins + get_plugin_class_map()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="300" height="70" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_pm" value="&lt;b&gt;text_pipeline_engine&lt;/b&gt;&lt;br&gt;(cluster or via_service)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="330" y="310" width="300" height="60" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_ex" value="&lt;b&gt;Spark executors (Python workers): rebuild class by name, load broadcast weights&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="630" height="60" as="geometry"/></mxCell><mxCell id="tdd_plugin_flow_e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_p1" target="tdd_plugin_flow_r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_plugin_flow_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_p1" target="tdd_plugin_flow_cm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="190"/><mxPoint x="645" y="190"/><mxPoint x="645" y="245"/></Array></mxGeometry></mxCell><mxCell id="tdd_plugin_flow_e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_p2" target="tdd_plugin_flow_pm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="290"/></Array></mxGeometry></mxCell><mxCell id="tdd_plugin_flow_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_p3" target="tdd_plugin_flow_cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_plugin_flow_e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_cm" target="tdd_plugin_flow_ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_plugin_flow_e5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_r" target="tdd_plugin_flow_cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_plugin_flow_e6" value="gRPC from UDF" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_plugin_flow_p4" target="tdd_plugin_flow_ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page19" name="20. Debugging and tracing: where every signal lives"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tdd_observability_title" value="&lt;b&gt;20. Debugging and tracing: where every signal lives&lt;/b&gt;&lt;br&gt;Follow a request by app id -&amp;gt; job -&amp;gt; stage -&amp;gt; task -&amp;gt; executor -&amp;gt; Python worker pid -&amp;gt; partition details" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1200" height="50" as="geometry"/></mxCell><mxCell id="tdd_observability_drv" value="&lt;b&gt;Driver console&lt;/b&gt;&lt;br&gt;[submit_pipeline_job] mode line,&lt;br&gt;result summary JSON,&lt;br&gt;Python tracebacks of failed tasks" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="260" height="110" as="geometry"/></mxCell><mxCell id="tdd_observability_res" value="&lt;b&gt;results/*.json&lt;/b&gt;&lt;br&gt;per-run summary, partition_details,&lt;br&gt;spark_ui_stats (REST snapshot)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="tdd_observability_ui" value="&lt;b&gt;Spark UIs&lt;/b&gt;&lt;br&gt;master :8080 (workers, apps)&lt;br&gt;application :4040 (jobs, stages,&lt;br&gt;tasks, executors, SQL plans)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="260" height="110" as="geometry"/></mxCell><mxCell id="tdd_observability_rest" value="&lt;b&gt;REST /api/v1/applications/...&lt;/b&gt;&lt;br&gt;jobs, stages, executors&lt;br&gt;(capture_spark_stats.py)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="tdd_observability_ev" value="&lt;b&gt;Event logs (spark.eventLog.enabled)&lt;/b&gt;&lt;br&gt;one JSON line per task&lt;br&gt;-&amp;gt; analyze_modes_stats.py" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="260" height="80" as="geometry"/></mxCell><mxCell id="tdd_observability_ex" value="&lt;b&gt;Executor logs&lt;/b&gt;&lt;br&gt;/opt/spark/work/&amp;lt;app&amp;gt;/&amp;lt;exec&amp;gt;/stderr&lt;br&gt;[Executor] host, pid, device,&lt;br&gt;model_load_time; Python errors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="600" y="0" width="280" height="110" as="geometry"/></mxCell><mxCell id="tdd_observability_wl" value="&lt;b&gt;Master / worker daemon logs&lt;/b&gt;&lt;br&gt;/opt/spark/logs/*master*, *worker*&lt;br&gt;(registration, executor launch)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="280" height="90" as="geometry"/></mxCell><mxCell id="tdd_observability_gpu" value="&lt;b&gt;GPU&lt;/b&gt;&lt;br&gt;nvidia-smi / dmon, torch.profiler&lt;br&gt;(benchmark/lowlevel_trace.py),&lt;br&gt;CUDA_LAUNCH_BLOCKING=1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="920" y="0" width="280" height="110" as="geometry"/></mxCell><mxCell id="tdd_observability_cw" value="&lt;b&gt;CloudWatch (AWS)&lt;/b&gt;&lt;br&gt;monitoring/*_publisher.py&lt;br&gt;SparkInference/{Spark,GPU,Benchmark}" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f4f1;strokeColor=#3f8f7f;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="280" height="90" as="geometry"/></mxCell><mxCell id="tdd_observability_kit" value="&lt;b&gt;Kitchen / Triton logs&lt;/b&gt;&lt;br&gt;docker logs ner-translate-server&lt;br&gt;Triton :8002 metrics" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="280" height="80" as="geometry"/></mxCell><mxCell id="tdd_observability_e0" value="writes" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_observability_drv" target="tdd_observability_res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_observability_e1" value="same data" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tdd_observability_ui" target="tdd_observability_rest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_observability_e2" value="persisted" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tdd_observability_rest" target="tdd_observability_ev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tdd_observability_e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tdd_observability_ex" target="tdd_observability_wl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page20" name="21. Air-gapped cluster simulation: models in HDFS, nodes fet"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="airgap_sim_topology_title" value="&lt;b&gt;21. Air-gapped cluster simulation: models in HDFS, nodes fetch into a local cache&lt;/b&gt;&lt;br&gt;deploy/docker-compose.airgap_sim.yml - profiles hdfs / service / cluster; MODEL_STORE_URI selects where models come from" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1330" height="50" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_hd" value="&lt;b&gt;HDFS (profile: hdfs) - &amp;#x27;master storage&amp;#x27;&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="330" height="360" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_nn" value="&lt;b&gt;hdfs-namenode :8020 RPC, :9870 WebHDFS&lt;/b&gt;&lt;br&gt;file system metadata: /models/weights/...&lt;br&gt;redirects reads to the datanode" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="290" height="80" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_dn" value="&lt;b&gt;hdfs-datanode :9866 data, :9864 HTTP&lt;/b&gt;&lt;br&gt;stores the blocks (128 MB each)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="290" height="70" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_st" value="&lt;b&gt;Upload once (T03)&lt;/b&gt;&lt;br&gt;hdfs dfs -put gliner-multi&lt;br&gt;  nllb-200-distilled-600M hf_cache&lt;br&gt;  /models/weights/   (4.6 GB)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="290" height="90" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_sv" value="&lt;b&gt;Service mode (profile: service)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="370" y="0" width="460" height="360" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_kit" value="&lt;b&gt;ner-translate-server  (the &amp;#x27;kitchen&amp;#x27;, GPU)&lt;/b&gt;&lt;br&gt;load(): model_store.resolve(MODEL_STORE_URI/&amp;lt;model&amp;gt;)&lt;br&gt; -&amp;gt; WebHDFS download into kitchen-cache (once)&lt;br&gt; -&amp;gt; GLiNER + NLLB loaded on the GPU, POST /predict" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="390" y="40" width="420" height="110" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_smw" value="&lt;b&gt;ner-translate-master&lt;/b&gt;&lt;br&gt;lean Spark master + driver" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_sww" value="&lt;b&gt;ner-translate-worker&lt;/b&gt;&lt;br&gt;lean executor: POST paths" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="610" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_kc" value="&lt;b&gt;kitchen-cache volume = that node&amp;#x27;s local disk (/model_cache)&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="390" y="290" width="420" height="50" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_cl" value="&lt;b&gt;Cluster mode (profile: cluster)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="870" y="0" width="460" height="360" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_cm" value="&lt;b&gt;ner-cluster-master&lt;/b&gt;&lt;br&gt;Spark master + driver" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="890" y="40" width="200" height="80" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_cw" value="&lt;b&gt;ner-cluster-worker (GPU)&lt;/b&gt;&lt;br&gt;executor: load() per task&lt;br&gt;-&amp;gt; model_store fetch&lt;br&gt;-&amp;gt; NER in-process" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="1110" y="40" width="200" height="110" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_wc" value="&lt;b&gt;worker-cache volume = worker node&amp;#x27;s local disk&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="890" y="180" width="420" height="50" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_fs" value="&lt;b&gt;Alternative source: master file system&lt;/b&gt;&lt;br&gt;MODEL_STORE_URI=file:///mnt/models (MODEL_FS_DIR mounted&lt;br&gt;read-only on every node) - no copy, no HDFS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#5c4a00;dashed=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="890" y="260" width="420" height="80" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_data" value="&lt;b&gt;Shared data volume ../data -&amp;gt; /app/data on every node: the same file paths are valid for Spark and the kitchen&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#1b1f24;" vertex="1" parent="1"><mxGeometry x="370" y="390" width="960" height="50" as="geometry"/></mxCell><mxCell id="airgap_sim_topology_e0" value="block locations" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="airgap_sim_topology_nn" target="airgap_sim_topology_dn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="airgap_sim_topology_e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;str