name: "ew_classifier"
platform: "pytorch_libtorch"
max_batch_size: 4096
input [ { name: "INPUT__0" data_type: TYPE_FP32 dims: [ 128 ] } ]
output [ { name: "OUTPUT__0" data_type: TYPE_FP32 dims: [ 8 ] } ]
dynamic_batching {
  preferred_batch_size: [ 1024, 2048, 4096 ]
  max_queue_delay_microseconds: 2000
}
instance_group [ { count: 2 kind: KIND_GPU } ]
