# Same as dev.env, for Docker CE inside a WSL2 Ubuntu distro (run compose
# from the Ubuntu shell). Windows drives appear under /mnt/<letter>.
# Variables already exported in the shell win over this file.

# Folder that directly contains gliner-multi/, nllb-200-distilled-600M/ and hf_cache/,
# mounted read-only at /mnt/models in every container.
# This dev PC (models on D:):
MODEL_FS_DIR=/mnt/d/pytorch-spark-inference-platform_20260921/models/weights
# Faster: a copy on the distro's own disk (cp -r /mnt/d/.../weights ~/ner/models/):
# MODEL_FS_DIR=/home/laptop-ou17pkm2kkc24/ner/models/weights
# Air-gapped system (models on E:):
# MODEL_FS_DIR=/mnt/e/ner/models/weights
MODEL_STORE_URI=file:///mnt/models

# Cluster on the plain multi-model-inference image, NER packages installed at
# start from a dependency image's files at /deps. Pick ONE way:
#   Way 1 - add-on deploy/docker-compose.ner_deps.yml (the image itself is mounted):
# NER_DEPS_IMAGE=ner-translate-deps:latest
#   Way 2 - add-on deploy/docker-compose.ner_deps_folder.yml (a folder exported
#           from the image once with docker create + docker export):
# NER_DEPS_FOLDER=/home/<user>/ner/deps
# Both ways, optional - force one wheel folder; found automatically otherwise:
# NER_WHEELS_DIR=/deps/<folder>
