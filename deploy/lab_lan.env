# LAB ONLY - variables for deploy/docker-compose.lab_lan.yml (Docker CE in WSL2
# Ubuntu). Variables already exported in the shell win over this file, so on
# the remote machine run:  LAB_NODE_IP=192.168.4.101 docker compose ...

# Master machine's LAN IP, as `ip -4 addr` shows it inside the Ubuntu distro.
LAB_MASTER_IP=192.168.4.104
# THIS machine's LAN IP (master machine: same as LAB_MASTER_IP).
LAB_NODE_IP=192.168.4.104

# Folder that directly contains gliner-multi/, nllb-200-distilled-600M/ and hf_cache/.
# Must exist on every node (same contents).
MODEL_FS_DIR=/mnt/d/pytorch-spark-inference-platform_20260921/models/weights
MODEL_STORE_URI=file:///mnt/models

# Ada's three images - load the SAME docker save tars that go to Ada.
LAB_MMI_IMAGE=multi-model-inference:latest
LAB_LEAN_IMAGE=spark-lean:latest
LAB_SERVER_IMAGE=ner-translate-server:latest
# Cluster mode takes the NER packages from this image (as on Ada).
NER_DEPS_IMAGE=ner-translate-server:latest

# Lab-only GPU run (docker-compose.lab_lan.gpu.yml, deploy/Dockerfile.lab_cu128).
LAB_MMI_GPU_IMAGE=multi-model-inference:lab-cu128
LAB_SERVER_GPU_IMAGE=ner-translate-server:lab-cu128

# Per-worker resources (raise memory with .wslconfig memory=).
LAB_WORKER_CORES=4
LAB_WORKER_MEMORY=6g
